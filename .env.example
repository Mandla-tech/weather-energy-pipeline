# If you are here, yu have followed the steps in my README
# Copy this file to .env and fill in your real values
# Remember to never commit .env to version control please

# API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# City configuration
WEATHER_CITY=Johannesburg
WEATHER_LAT=-26.2041
WEATHER_LON=28.0473

# PostgreSQL
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=weather_energy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow
AIRFLOW_UID=50000
